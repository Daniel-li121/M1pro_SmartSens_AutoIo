<sensorDriverData>
    <module_version major_revision="1" minor_revision="0" incr_revision="0" />
    <!--Sensor slave information -->
    <slaveInfo>
        <!--Name of the sensor -->
        <sensorName>sc120as</sensorName>
        <!--8-bit write slave address -->
        <slaveAddress>0x60</slaveAddress>
        <!--Register address / data size in bytes -->
        <regAddrType range="[1,4]">2</regAddrType>
        <!--Register address / data size in bytes -->
        <regDataType range="[1,4]">1</regDataType>
        <!--Frame length lines of frame
        Typically this value is the active height + blanking height -->
        <frameLengthLines>3375</frameLengthLines>
        <!--Maximum frame rate -->
        <frameRate>30</frameRate>
        <vm>0x7fff</vm>
        <vm_ae>0x80</vm_ae>
        <vm_contrast>0x2</vm_contrast>
        <vm_tone>0x1</vm_tone>
        <width>0x3208,0x3209</width>
        <height>0x320a,0x320b</height>
    </slaveInfo>
    <regAddrInfo_Option>
        <ISP_En>xxx</ISP_En>
        <AE_En>0x303e</AE_En>
        <!--manual：0x3000[7]=0,0x3000[3]=1；auto：0x3000[7]=1,0x3000[3]=0-->
        <BLC_En>xxx</BLC_En>
        <LSC_En>0x5000</LSC_En>
        <!--0x5000[5]-->
        <Gamma_En>xxx</Gamma_En>
        <WB_En>xxx</WB_En>
        <CCM_En>0x5100</CCM_En>
        <!--0x5100[0]-->
        <Saturation_En>xxx</Saturation_En>
        <Contrast_En>xxx</Contrast_En>
        <Tonemapping_En>xxx</Tonemapping_En>
        <Sharpness_En>xxx</Sharpness_En>
        <GB_En>xxx</GB_En>
        <CAC_En>xxx</CAC_En>
        <NR_En>0x5000</NR_En>
        <!--0x5000[3]-->
        <Check>0x4992~0x4997,0x4743</Check>
        <!--self-checking-->
        <Bridge_En Value="0x22,0xaa,0x10,0x0b,0x92">0x300c,0x3313,0x3044,0x3034,0x3641</Bridge_En>
        <!--接通EEPROM-->
    </regAddrInfo_Option>
    <regAddrInfo_AE>
        <ExpTimeType>0x309e</ExpTimeType>
        <!--manual：0x309e[6]=0；auto：0x309e[6]=1-->
        <ManualLExp ReadOnly="1">0x3e00,0x3e01,0x3e02</ManualLExp>
        <!--0x3e00[3:0],0x3e01,0x3e02[7:4]-->
        <ManualMExp ReadOnly="1">0x3e50,0x3e51,0x3e52</ManualMExp>
        <!--0x3e50[3:0],0x3e51,0x3e52[7:4]-->
        <ManualSExp ReadOnly="1">0x3e22,0x3e04,0x3e05</ManualSExp>
        <!--0x3e22[3:0],0x3e04,0x3e05[7:4]-->
        <AutoLExpMin>0x5e82,0x5e83</AutoLExpMin>
        <AutoMExpMin>0x5e84,0x5e85</AutoMExpMin>
        <AutoSExpMin>0x5e86,0x5e87</AutoSExpMin>
        <AutoLExpMax>0x5e88,0x5e89</AutoLExpMax>
        <AutoMExpMax>0x5e8a,0x5e8b</AutoMExpMax>
        <AutoSExpMax>0x5e8c,0x5e8d</AutoSExpMax>
        <AutoLExpMaxTop ReadOnly="1">0x320e,0x320f</AutoLExpMaxTop>
        <AGainType>0x3e0d</AGainType>
        <!--0x3e0d[2:0]=3'b111, 0x3e0d[0]:1-Long ana gain manual en, 0x3e0d[1]:1-Medium ana gain manual en, 0x3e0d[2]:1-Short ana gain manual en-->
        <ManualLAGain ReadOnly="1">0x3e08,0x3e09</ManualLAGain>
        <ManualMAGain ReadOnly="1">0x3e58,0x3e59</ManualMAGain>
        <ManualSAGain ReadOnly="1">0x3e12,0x3e13</ManualSAGain>
        <AutoLAGainMin>0x5e76,0x5e77</AutoLAGainMin>
        <!--模拟增益最小值 寄存器-->
        <AutoMAGainMin>0x5e78,0x5e79</AutoMAGainMin>
        <AutoSAGainMin>0x5e7a,0x5e7b</AutoSAGainMin>
        <AutoLAGainMaxFlag ReadOnly="1">0x4756</AutoLAGainMaxFlag>
        <!--0x4756[3]-->
        <AutoLAGainMax>0x5e7c,0x5e7d</AutoLAGainMax>
        <AutoLAGainMax1>0x476f</AutoLAGainMax1>
        <!--0x476f << 4-->
        <!--模拟增益最大值 寄存器-->
        <AutoMAGainMax>0x5e7e,0x5e7f</AutoMAGainMax>
        <AutoSAGainMax>0x5e80,0x5e81</AutoSAGainMax>
        <DGainType>xxx</DGainType>
        <!--手动/自动 数字增益模式，控制寄存器-->
        <ManualLDGain ReadOnly="1">0x3e06,0x3e07</ManualLDGain>
        <ManualMDGain ReadOnly="1">0x3e56,0x3e57</ManualMDGain>
        <ManualSDGain ReadOnly="1">0x3e10,0x3e11</ManualSDGain>
        <AutoLDGainMin>xxx</AutoLDGainMin>
        <!--长曝光 数字增益最小值 寄存器-->
        <AutoMDGainMin>xxx</AutoMDGainMin>
        <!--中曝光 数字增益最小值 寄存器-->
        <AutoSDGainMin>xxx</AutoSDGainMin>
        <!--短曝光 数字增益最小值 寄存器-->
        <AutoLDGainMax>xxx</AutoLDGainMax>
        <!--maxLGain 0x5e7c[3:0],0x5e7d;  长曝光 数字增益最大值 寄存器-->
        <AutoMDGainMax>xxx</AutoMDGainMax>
        <!--maxMGain 0x5e7e[3:0],0x5e7f;  中曝光 数字增益最大值 寄存器-->
        <AutoSDGainMax>xxx</AutoSDGainMax>
        <!--maxSGain 0x5e80[3:0],0x5e81;  短曝光 数字增益最大值 寄存器-->
        <HDROutputFormat>0x5019</HDROutputFormat>
        <!--combine:0x5019=0x40-->
        <!--L:0x5019=0x44-->
        <!--M:0x5019=0x45-->
        <!--S:0x5019=0x46-->
        <!--LFS:0x5019=0x47-->
        <ExpGainCGain ReadOnly="1">0x6e2b,0x6e2c,0x6e2d</ExpGainCGain>
        <ExpGainCEX ReadOnly="1">0x6e2e,0x6e2f</ExpGainCEX>
        <AETarget1>0x5e62</AETarget1>
        <AETarget2>0x5ee4</AETarget2>
        <AETarget3>0x5ee5</AETarget3>
        <AETarget4>0x5ee6</AETarget4>
        <AETargetThre1>0x5ee8,0x5ee9</AETargetThre1>
        <!--0x80 is 1x-->
        <AETargetThre2>0x5eea,0x5eeb</AETargetThre2>
        <!--0x80 is 1x-->
        <AETargetThre3>0x5eec,0x5eed</AETargetThre3>
        <!--0x80 is 1x-->
        <AETargetThre4>0x5eee,0x5eef</AETargetThre4>
        <!--0x80 is 1x-->
        <AESpeedFM>0x5e66</AESpeedFM>
        <!--long expo ae speed-->
        <AESpeedSM>0x5e67</AESpeedSM>
        <!--long expo ae speed-->
        <AETolerance1>0x5e68</AETolerance1>
        <!--long exp ae tolerance: unstable to stable-->
        <AETolerance2>0x5e69</AETolerance2>
        <!--long exp ae tolerance: stable to unstable-->
        <Antiflicker>0x5e60</Antiflicker>
        <!--0x5e60[0]=1: en-->
        <ExpAntiflickerFreq>0x5e9b,0x5e9c</ExpAntiflickerFreq>
        <!--0x5e9b[5:0], 0x5e9c,  0x5e9c[3:0] is decimal place; {0x3e00,0x3e01,0x3e02} should be integral multiple of {0x5e9b,0x5e9c}-->
        <Pll2Sclk>0x3106</Pll2Sclk>
        <Div0MUL>0x36f9,0x36e9</Div0MUL>
        <DivPMULDiv2En>0x36fd,0x36ed</DivPMULDiv2En>
        <DivPMUL>0x36fa,0x36ea</DivPMUL>
        <DivSclk1>0x36fb,0x36eb</DivSclk1>
        <DivRatio>0x320c,0x320d</DivRatio>
        <Mean ReadOnly="1">0x6e30,0x6e60,0x6e90</Mean>
        <ROIMirrorEnable>0x3221</ROIMirrorEnable>
        <ROILeft>0x5e16,0x5e17,0x5e36,0x5e37,0x5e56,0x5e57</ROILeft>
        <ROITop>0x5e1a,0x5e1b,0x5e3a,0x5e3b,0x5e5a,0x5e5b</ROITop>
        <ROIWidth>0x6ec0,0x6ec1,0x6ec4,0x6ec5,0x6ec8,0x6ec9</ROIWidth>
        <ROIHeight>0x6ec2,0x6ec3,0x6ec6,0x6ec7,0x6eca,0x6ecb</ROIHeight>
        <ROIBottom>0x5e1c,0x5e1d,0x5e3c,0x5e3d,0x5e5c,0x5e5d</ROIBottom>
        <ROIXShift>0x3210,0x3211</ROIXShift>
        <ROIYShift>0x3212,0x3213</ROIYShift>
        <!-- 只用于220at，不用于130AT -->
        <HdrType>0x3281</HdrType>
        <!--读取0x3281[7]确认模式: 1表示pghdr，0表示shdr-->
        <LFSEnable>0x5b58</LFSEnable>
        <!--LFSEnable：0x5b58 bit4置1为关，0为开-->
        <LFSType>0x5e61</LFSType>
        <!--LFS auto：0x5e61[0]=1 AUTO ；0 手动-->
        <ManualLExpShdr ReadOnly="1">0x3e00,0x3e01,0x3e02</ManualLExpShdr>
        <!--0x3e00[3:0],0x3e01,0x3e02[7:4]  -->
        <ManualMExpShdr ReadOnly="1">0x3e50,0x3e51,0x3e52</ManualMExpShdr>
        <!--0x3e50[3:0],0x3e51,0x3e52[7:4]  -->
        <ManualSExpShdr ReadOnly="1">0x3e22,0x3e04,0x3e05</ManualSExpShdr>
        <!--0x3e22[3:0],0x3e04,0x3e05[7:4]  -->
        <ManualLFSExpShdr ReadOnly="1">0x3e70,0x3e71,0x3e72</ManualLFSExpShdr>
        <!--0x3e70[3:0],0x3e71,0x3e72[7:4]  -->
        <ManualLFSEnablePghdr>0x34d3</ManualLFSEnablePghdr>
        <!--0x34d3=0x00,Pghdr模式下无LFS, ManualSExpPghdr={0x3e22,0x3e04,0x3e05}，ManualSAGainPghdr={0x3e12,0x3e13}；-->
        <!--0x34d3=0x84,Pghdr模式下有LFS, ManualSExpPghdr={0x3e50,0x3e51,0x3e52}，ManualSAGainPghdr={0x3e58,0x3e59}；-->
        <ManualLExpPghdr ReadOnly="1">0x3e00,0x3e01,0x3e02</ManualLExpPghdr>
        <!--0x3e00[3:0],0x3e01,0x3e02[7:4]  -->
        <ManualMExpPghdr ReadOnly="1">0x3e00,0x3e01,0x3e02</ManualMExpPghdr>
        <!--0x3e00[3:0],0x3e01,0x3e02[7:4]  -->
        <ManualSExpPghdr ReadOnly="1">0x3e50,0x3e51,0x3e52</ManualSExpPghdr>
        <!--0x3e50[3:0],0x3e51,0x3e52[7:4]  -->
        <ManualLFSExpPghdr ReadOnly="1">0x3e22,0x3e04,0x3e05</ManualLFSExpPghdr>
        <!--0x3e22[3:0],0x3e04,0x3e05[7:4]  -->
        <AutoLExpMinShdr>0x5e82,0x5e83</AutoLExpMinShdr>
        <AutoMExpMinShdr>0x5e84,0x5e85</AutoMExpMinShdr>
        <AutoSExpMinShdr>0x5e86,0x5e87</AutoSExpMinShdr>
        <AutoLFSExpMinShdr>0x5ef0,0x5ef1</AutoLFSExpMinShdr>
        <AutoLExpMinPghdr>0x5e82,0x5e83</AutoLExpMinPghdr>
        <AutoMExpMinPghdr>0x5e84,0x5e85</AutoMExpMinPghdr>
        <AutoSExpMinPghdr>0x5e86,0x5e87</AutoSExpMinPghdr>
        <AutoLFSExpMinPghdr>0x5ef0,0x5ef1</AutoLFSExpMinPghdr>
        <AutoLExpMaxShdr>0x5e88,0x5e89</AutoLExpMaxShdr>
        <AutoMExpMaxShdr>0x5e8a,0x5e8b</AutoMExpMaxShdr>
        <AutoSExpMaxShdr>0x5e8c,0x5e8d</AutoSExpMaxShdr>
        <AutoLFSExpMaxShdr>0x5ef2,0x5ef3</AutoLFSExpMaxShdr>
        <AutoLExpMaxPghdr>0x5e88,0x5e89</AutoLExpMaxPghdr>
        <AutoMExpMaxPghdr>0x5e8a,0x5e8b</AutoMExpMaxPghdr>
        <AutoSExpMaxPghdr>0x5e8c,0x5e8d</AutoSExpMaxPghdr>
        <AutoLFSExpMaxPghdr>0x5ef2,0x5ef3</AutoLFSExpMaxPghdr>
        <ManualLAGainShdr ReadOnly="1">0x3e08,0x3e09</ManualLAGainShdr>
        <ManualMAGainShdr ReadOnly="1">0x3e58,0x3e59</ManualMAGainShdr>
        <ManualSAGainShdr ReadOnly="1">0x3e12,0x3e13</ManualSAGainShdr>
        <ManualLFSAGainShdr ReadOnly="1">0x3e78,0x3e79</ManualLFSAGainShdr>
        <ManualLAGainPghdr ReadOnly="1">0x3e08,0x3e09</ManualLAGainPghdr>
        <ManualMAGainPghdr ReadOnly="1">0x3e82,0x3e83</ManualMAGainPghdr>
        <ManualSAGainPghdr ReadOnly="1">0x3e58,0x3e59</ManualSAGainPghdr>
        <ManualLFSAGainPghdr ReadOnly="1">0x3e12,0x3e13</ManualLFSAGainPghdr>
        <AutoLAGainMinShdr>0x5e76,0x5e77</AutoLAGainMinShdr>
        <AutoMAGainMinShdr>0x5e78,0x5e79</AutoMAGainMinShdr>
        <AutoSAGainMinShdr>0x5e7a,0x5e7b</AutoSAGainMinShdr>
        <AutoLFSAGainMinShdr>0x5ee0,0x5ee1</AutoLFSAGainMinShdr>
        <AutoLAGainMinPghdr>0x5e76,0x5e77</AutoLAGainMinPghdr>
        <AutoMAGainMinPghdr>0x5e78,0x5e79</AutoMAGainMinPghdr>
        <AutoSAGainMinPghdr>0x5e7a,0x5e7b</AutoSAGainMinPghdr>
        <AutoLFSAGainMinPghdr>0x5ee0,0x5ee1</AutoLFSAGainMinPghdr>
        <AutoLAGainMaxShdr>0x5e7c,0x5e7d</AutoLAGainMaxShdr>
        <AutoMAGainMaxShdr>0x5e7e,0x5e7f</AutoMAGainMaxShdr>
        <AutoSAGainMaxShdr>0x5e80,0x5e81</AutoSAGainMaxShdr>
        <AutoLFSAGainMaxShdr>0x5ee2,0x5ee3</AutoLFSAGainMaxShdr>
        <AutoLAGainMaxPghdr>0x5e7c,0x5e7d</AutoLAGainMaxPghdr>
        <AutoMAGainMaxPghdr>0x5e7e,0x5e7f</AutoMAGainMaxPghdr>
        <AutoSAGainMaxPghdr>0x5e80,0x5e81</AutoSAGainMaxPghdr>
        <AutoLFSAGainMaxPghdr>0x5ee2,0x5ee3</AutoLFSAGainMaxPghdr>
    </regAddrInfo_AE>
    <regAddrInfo_AE_130>
        <ROIUseOneSet>0x5ec4</ROIUseOneSet>
        <!-- 0x5ec4[3] ROI 使用同一组参数 -->
        <ROIParamChoose>0x5ec4</ROIParamChoose>
        <!-- 0x5ec4[2:0] 选择ROI 使用L/M/S参数 -->
        <Matrix>0x6f80~0x6faf</Matrix>
        <!-- L：	0x6f80-0x6f8f（每2个bit为一个数值）
             M：	0x6f90-0x6f9f（每2个bit为一个数值）
             S：	0x6fa0-0x6faf（每2个bit为一个数值） -->
        <ROIMirrorEnable ReadOnly="1">0x3221</ROIMirrorEnable>
        <ROILeft>0x6fb0,0x6fb1,0x6fb8,0x6fb9,0x6fc0,0x6fc1</ROILeft>
        <ROITop>0x6fb2,0x6fb3,0x6fba,0x6fbb,0x6fc2,0x6fc3</ROITop>
        <ROIWidth>0x6fb4,0x6fb5,0x6fbc,0x6fbd,0x6fc4,0x6fc5</ROIWidth>
        <ROIHeight>0x6fb6,0x6fb7,0x6fbe,0x6fbf,0x6fc6,0x6fc7</ROIHeight>
        <ROIXShift>0x3210,0x3211</ROIXShift>
        <ROIYShift>0x3212,0x3213</ROIYShift>
    </regAddrInfo_AE_130>
    <regAddrInfo_AutoLowLevel_130>
        <CurvePreEnable>0x5011</CurvePreEnable>
        <!-- 0x5011[5] 置1 打开curve pre模块 -->
        <LowLevelType>0x5adc</LowLevelType>
        <!-- 0x5adc[7] 置1，进入手动模式
             0x5adc[7] 置0，进入自动模式 -->
        <ManualLowLevel>0x5adc</ManualLowLevel>
        <!-- 0x5adc[6:0]，设置手动输入的low level 变化大小 -->
        <AutolLowLevel_130>0x5aaf</AutolLowLevel_130>
        <!-- 0x5aaf，为low level 自动变化时的实际大小 -->
        <AutolLowLevel_220>0x5adf</AutolLowLevel_220>
        <!-- 0x5adf，为low level 自动变化时的实际大小 -->
        <LowLevelStartGain>0x5add</LowLevelStartGain>
        <!-- 0x5add设置low level 随增益变化的增益起始值，增益大于这个值，low level开始变化 -->
        <LowLevelSpeedGain>0x5adc</LowLevelSpeedGain>
        <!-- 0x5adc[1:0]，设置low level 随增益变化的快慢，2’b00,2’b01,2’b10,2’b11对应1/8,2/8,3/8,4/8 -->
        <LowLevelMaxGain>0x5ade</LowLevelMaxGain>
        <!-- 0x5ade[3:0]，*4，设置low level随增益变化最大值 -->
        <LowLevelSpeedTemp>0x5adc</LowLevelSpeedTemp>
        <!-- 0x5adc[3:2]，设置low level 随温度升高变化的快慢，2’b00,2’b01,2’b10,2’b11对应0,1,2,4 -->
        <LowLevelMaxTemp>0x5ade</LowLevelMaxTemp>
        <!-- 0x5ade[7:4]，*4，设置low level随温度变化最大值 -->
        <BrightInputChoose>0x5adc</BrightInputChoose>
        <!-- 0x5adc[6]，选择不同的亮度输入作为判断，0：选择AE长曝光的平均值；1：选择curev之后的平均值 -->
        <LowLevelStartBright>0x5adf</LowLevelStartBright>
        <!-- 0x5adf[3:0]，*8设置low level 随亮度变化的亮度起始值（8bit，高位补零，显示运算后的value），亮度小于这个值，low level开始变化 -->
        <LowLevelSpeedBright>0x5adc</LowLevelSpeedBright>
        <!-- 0x5adc[5:4]，设置low level 随亮度变化的快慢，2’b00,2’b01,2’b10,2’b11对应1/8,2/8,3/8,4/8 -->
        <LowLevelMaxBright>0x5adf</LowLevelMaxBright>
        <!-- 0x5adf[7:4]，*4，设置low level随增益变化最大值 -->
        <CurrentGain ReadOnly="1">0x60ef</CurrentGain>
        <!--Current gain :0x60ef-->
        <CurrentTemp ReadOnly="1">0x5ae7</CurrentTemp>
        <!--Current temperature :0x5ae7[5:0]-->
    </regAddrInfo_AutoLowLevel_130>
    <regAddrInfo_BLC>
        <Enable>0x3900</Enable>
        <!-- 0x3900[1]=1: On, 0x3900[1]=0: Off -->
        <BLC_Type>0x3902</BLC_Type>
        <!-- 0x3902[6]=1: auto, 0x3902[6]=0: manual -->
        <Statistics_Type>0x3905</Statistics_Type>
        <!-- 0x3905[7:4]=b0100, 对应于 1channel 
             0x3905[7:4]=b0010, 对应于 1line
             0x3905[7:4]=b1000, 对应于 1row
             0x3905[7:4]=b1010, 对应于 1col
             0x3905[7:4]=b0000, 对应于 4channel -->
        <Target>0x3907,0x3908</Target>
        <Statistics_Start_Line>0x3901</Statistics_Start_Line>
        <!-- 默认0x02 -->
        <Statistics_Total_Line>0x3904</Statistics_Total_Line>
        <!-- 默认0x04 -->
        <Trigger_Always>0x3905</Trigger_Always>
        <!-- 0x3905[1]=1: On, 0x3905[1]=0: Off -->
        <Trigger_Continuous_Frame_Average>0x3900</Trigger_Continuous_Frame_Average>
        <!-- 0x3900[4]=1: On, 0x3900[4]=0: Off -->
        <Trigger_Multi_Thre>0x391e</Trigger_Multi_Thre>
        <!-- 0x391e[3]=1: On, 0x391e[3]=0: Off -->
        <Trigger_Out_Of_Range>0x391e</Trigger_Out_Of_Range>
        <!-- 0x391e[0]=1: On, 0x391e[0]=0: Off -->
        <Trigger_Multi_Thre0>0x391d</Trigger_Multi_Thre0>
        <!-- 默认0x03, 含4bit小数位 -->
        <Trigger_Multi_Thre1>0x3963</Trigger_Multi_Thre1>
        <!-- 默认0x07, 含4bit小数位 -->
        <Trigger_Multi_Thre2>0x397b</Trigger_Multi_Thre2>
        <!-- 默认0x0f, 含4bit小数位 -->
        <Trigger_Multi_Thre3>0x3993</Trigger_Multi_Thre3>
        <!-- 默认0x1f, 含4bit小数位 -->
        <Trigger_Auto_Average_Weight>0x3926</Trigger_Auto_Average_Weight>
        <!-- 0x3926[6]=1: On, 0x3926[6]=0: Off -->
        <Trigger_Auto_Average_Weight_Thre0>0x39dd</Trigger_Auto_Average_Weight_Thre0>
        <!-- 默认0x01 -->
        <Trigger_Auto_Average_Weight_Thre1>0x39de</Trigger_Auto_Average_Weight_Thre1>
        <!-- 默认0x02 -->
        <Trigger_Auto_Average_Weight_Thre2>0x39e7</Trigger_Auto_Average_Weight_Thre2>
        <!-- 默认0x04 -->
        <Trigger_Auto_Average_Weight_Thre3>0x39e8</Trigger_Auto_Average_Weight_Thre3>
        <!-- 默认0x08 -->
        <Trigger_Auto_Average_Weight_Thre4>0x3926</Trigger_Auto_Average_Weight_Thre4>
        <!-- 默认0x00 -->
        <Blcmax_High_Temp_Correct>0x3933</Blcmax_High_Temp_Correct>
