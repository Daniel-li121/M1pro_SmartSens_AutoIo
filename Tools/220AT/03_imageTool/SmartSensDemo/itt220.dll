        <Area_Judge_Brightnes_ISGreater_Thre>0x60c0,0x61c0,0x62c0,0x58c0</Area_Judge_Brightnes_ISGreater_Thre>
        <!--Set to 0, 2*3 area is greater than the brightness threshold, CAC brightness are considered OK: 0x6xc0[5]-->
        <Area_Judge_Brightnes_Large_ISBright>0x61c0,0x62c0,0x58c0</Area_Judge_Brightnes_Large_ISBright>
        <!--consider whether the large area corresponding to the long exposure point is a bright area: 0x61c0[0] (Except for long exposure) -->
        <Area_Judge_Brightnes_Small_ISBright>0x61c0,0x62c0,0x58c0</Area_Judge_Brightnes_Small_ISBright>
        <!--consider whether the small area corresponding to the long exposure point is a bright area: 0x61c0[1] (Except for long exposure) -->
        <Area_Judge_Gain_Thre>0x60bd,0x61bd,0x62bd,0x58bd</Area_Judge_Gain_Thre>
        <!--Gain threshold: 0x6xbd[6:0]-->
        <Area_Judge_Gain_Speed>0x60bf,0x61bf,0x62bf,0x58bf</Area_Judge_Gain_Speed>
        <!--Calibrate intensity gradually decreases with increasing gain: 0x6xbf[7:4]-->
        <Area_Judge_Col_Blue>0x60c7,0x61c7,0x62c7,0x58c7</Area_Judge_Col_Blue>
        <!--Calibrate intensity gradually decreases with increasing gain: 0x6xc7-->
        <Area_Judge_Col_Red>0x60c8,0x61c8,0x62c8,0x58c8</Area_Judge_Col_Red>
        <!--Calibrate intensity gradually decreases with increasing gain: 0x6xc8-->
