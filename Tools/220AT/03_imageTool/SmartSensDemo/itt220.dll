        <Red_Scene_Processed_Lower>0x5280</Red_Scene_Processed_Lower>
        <!-- 红色场景降饱和度 0x5280[4]为1为打开红色场景降饱和度，0为关闭 -->
        <Red_Scene_Enable>0x5ad0</Red_Scene_Enable>
