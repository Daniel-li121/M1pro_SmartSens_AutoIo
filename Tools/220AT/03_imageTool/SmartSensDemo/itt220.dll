        <!--Calibrate intensity gradually decreases with increasing gain: 0x6xe0[3:2]-->
        <Area_Judge_Col_Red_Speed>0x60e0,0x61e0,0x62e0,0x58e0</Area_Judge_Col_Red_Speed>
        <!--Calibrate intensity gradually decreases with increasing gain: 0x6xe0[5:4]-->
        <Area_Judge_Edge_Vale_ISNecess>0x60c0,0x61c0,0x62c0,0x58c0</Area_Judge_Edge_Vale_ISNecess>
        <!--Set it to 1 make the edge value a necessary condition: 0x6xc0[3]-->
        <Area_Judge_Edge_ISCommon>0x60c0,0x61c0,0x62c0,0x58c0</Area_Judge_Edge_ISCommon>
        <!--Set it to 1 make the edge value a necessary condition: 0x6xc0[6]-->
        <Area_Judge_Edge_Second_Thre>0x60be,0x61be,0x62be,0x58be</Area_Judge_Edge_Second_Thre>
        <!--Brightness threshold: 0x6xbe-->
        <Area_Judge_Edge_Second_Speed>0x60bf,0x61bf,0x62bf,0x58bf</Area_Judge_Edge_Second_Speed>
        <!--Brightness Speed: 0x6xbf[3:0]-->
        <Area_Judge_Edge_Value_Thre>0x60c5,0x61c5,0x62c5,0x58c5</Area_Judge_Edge_Value_Thre>
        <!--Set the threshold of an edge value: 0x6xc5-->
        <Area_Judge_Edge_Value_Speed>0x60c6,0x61c6,0x62c6,0x58c6</Area_Judge_Edge_Value_Speed>
        <!--Set the threshold of an edge value: 0x6xc6[7:4]-->
        <Area_Judge_Edge_Blue_ISNecess>0x60c0,0x61c0,0x62c0,0x58c0</Area_Judge_Edge_Blue_ISNecess>
        <!--Set the threshold of an edge value: 0x6xc0[2]-->
        <Area_Judge_Edge_Blue_Brightness_Thre>0x60c4,0x61c4,0x62c4,0x58c4</Area_Judge_Edge_Blue_Brightness_Thre>
        <!--Set the brightness threshold of the bright color: 0x6xc4-->
        <Area_Judge_Edge_Blue_Brightness_Speed>0x60c6,0x61c6,0x62c6,0x58c6</Area_Judge_Edge_Blue_Brightness_Speed>
        <!--Set the brightness threshold of the bright color: 0x6xc6[3:0]-->
        <Strength>0x60c1,0x61c1,0x62c1,0x58c1</Strength>
        <!--Set speed CAC correction intensity decreases as the blue brightness increases: 0x6xc1[7:4]-->
