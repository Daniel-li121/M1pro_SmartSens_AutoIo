        <!--DnsEdgeInt 1~6，每8bit为一个值-->
        <DnsEdgeCoe>0x5342~0x5347</DnsEdgeCoe>
        <!--DnsEdgeCoe 1~6，每8bit为一个值-->
        <DnsAddBack>0x5360~0x5365</DnsAddBack>
        <!--DnsAddBack 1~6，每8bit为一个值-->
    </regAddrInfo_NR_133>
    <regAddrInfo_Sharpness_133>
        <!--133AT_233AT Sharpness-->
        <ManualGainEnable>0x5300</ManualGainEnable>
        <!--开关0x5300[4]-->
        <ManualGain>0x5327,0x5328</ManualGain>
        <!--手动设置当前生效增益-->
