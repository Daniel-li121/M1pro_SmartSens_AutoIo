<sensorDriverData>
    <module_version major_revision="1" minor_revision="0" incr_revision="0" />
    <!--Sensor slave information -->
    <slaveInfo>
        <!--Name of the sensor -->
        <sensorName>sc120as</sensorName>
        <!--8-bit write slave address -->
        <slaveAddress>0x60</slaveAddress>
        <!--Register address / data size in bytes -->
        <regAddrType range="[1,4]">2</regAddrType>
        <!--Register address / data size in bytes -->
        <regDataType range="[1,4]">1</regDataType>
        <!--Frame length lines of frame
        Typically this value is the active height + blanking height -->
        <frameLengthLines>3375</frameLengthLines>
        <!--Maximum frame rate -->
        <frameRate>30</frameRate>
        <vm>0x7fff</vm>
        <vm_ae>0x0</vm_ae>
        <vm_contrast>0x2</vm_contrast>
        <vm_tone>0x1</vm_tone>
        <width>0x3208,0x3209</width>
        <height>0x320a,0x320b</height>
    </slaveInfo>
	<regAddrInfo_EEPROM>
        <Bridge_En Value="0x92,0x0b">0x3641,0x3034</Bridge_En>
        <!--接通EEPROM-->
    </regAddrInfo_EEPROM>
    <regAddrInfo_PWL>
        <!--功能使能enable：0x5006[3]-->
        <Enable>0x5006</Enable>
        <!--x list：0x5d00 ~ 0x5d1b（一列表格显示，4 byte有效）-->
        <XList>0x5d00~0x5d1b</XList>
        <!--y list：0x5d20 ~ 0x5d2d(一列表格显示，2 byte有效)-->
        <YList>0x5d20~0x5d2d</YList>
        <!--slope：0x5d30 ~ 0x5d4f（一列表格显示，4 byte有效）-->
        <SlopeList>0x5d30~0x5d4f</SlopeList>
    </regAddrInfo_PWL>
    <regAddrInfo_AE>
        <Type>0x5019,0x5b8a</Type>
        <!--combine：    0x5019[3:0] = 0, 0x5b8a[5:4] = 0
            dcg combine：0x5019[3:0] = 4, 0x5b8a[5:4] = 0
            me：         0x5019[3:0] = 4, 0x5b8a[5:4] = 1
            le：         0x5019[3:0] = 4, 0x5b8a[5:4] = 2
            short：      0x5019[3:0] = 5, 0x5b8a[5:4] = 0
            lfs          0x5019[3:0] = 6, 0x5b8a[5:4] = 0 -->
        <MeanLe>0x6711~0x6713</MeanLe>
        <MeanMe>0x6751~0x6753</MeanMe>
        <MeanSe>0x6791~0x6793</MeanSe>
        <MeanLfs>0x67d1~0x67d3</MeanLfs>
        <MeanComb>0x6811~0x6813</MeanComb>
        <ExpTimeLe>0x3e00~0x3e02</ExpTimeLe>
        <!--time LE：0x3e00[7:0], 0x3e01[7:0], 0x3e02[7:4]-->
        <ExpGainLe>0x3e08~0x3e09</ExpGainLe>
        <ExpTimeMe>0x3e00~0x3e02</ExpTimeMe>
        <!--time ME：0x3e00[7:0], 0x3e01[7:0], 0x3e02[7:4]-->
        <ExpGainMe>0x3e82~0x3e83</ExpGainMe>
        <ExpTimeSe>0x3e50~0x3e52</ExpTimeSe>
        <!--time SE：0x3e50[7:0], 0x3e51[7:0], 0x3e52[7:4]-->
        <ExpGainSe>0x3e58~0x3e59</ExpGainSe>
        <ExpTimeLfs>0x3e22,0x3e04,0x3e05</ExpTimeLfs>
        <!--time LFS：0x3e22[7:0], 0x3e04[7:0], 0x3e05[7:4]-->
        <ExpGainLfs>0x3e12~0x3e13</ExpGainLfs>
        <LFSThre1>0x5b57</LFSThre1>
        <!--0x5b57[7:0],-->
        <LFSThre2>0x5b58,0x5b59</LFSThre2>
        <!--0x5b58[3:0],0x5b59[7:0],-->
        <LFSThre3>0x5b5a</LFSThre3>
        <!--0x5b5a[4:0],-->
        <LFSThre4>0x5b5b</LFSThre4>
        <!--0x5b5b[5:0],-->
        <LFSThre5>0x5b5c</LFSThre5>
        <!--0x5b5c[7:0],-->
        <LFSThre6>0x5b5d</LFSThre6>
        <!--0x5b5d[5:0],-->
        <LFSThre7>0x5b5e,0x5b5f</LFSThre7>
        <!--0x5b5e[3:0],0x5b5f[7:0],-->
        <LFSBloomingEnable>0x5b61</LFSBloomingEnable>
        <!--0x5b61[6],-->
    </regAddrInfo_AE>
    <regAddrInfo_LSC>
        <Enable>0x5000</Enable>
        <LSC_LPD_A>0x9e10~0x9eff</LSC_LPD_A>
        <LSC_LPD_B>0x9d20~0x9e0f</LSC_LPD_B>
        <LSC_LPD_C>0x9c30~0x9d1f</LSC_LPD_C>
        <LSC_SPD_A>0x9b40~0x9c2f</LSC_SPD_A>
        <LSC_SPD_B>0x9a50~0x9b3f</LSC_SPD_B>
        <LSC_SPD_C>0x9960~0x9a4f</LSC_SPD_C>
    </regAddrInfo_LSC>
    <regAddrInfo_WB_CCM>
        <!-- WB -->
        <WB_Enable>0x3e1f</WB_Enable>
        <!-- WB enable：0x3e1f[7] -->
		    <AwbGainEnable>0x3e1f</AwbGainEnable>
        <!-- awb gain enable： 0x3e1f[6] -->
        <LeGr>0x4f00~0x4f01</LeGr>
        <LeR>0x4f02~0x4f03</LeR>
        <LeB>0x4f04~0x4f05</LeB>
        <LeGb>0x4f06~0x4f07</LeGb>
        <MeGr>0x4f08~0x4f09</MeGr>
        <MeR>0x4f0a~0x4f0b</MeR>
        <MeB>0x4f0c~0x4f0d</MeB>
        <MeGb>0x4f0e~0x4f0f</MeGb>
        <LfsGr>0x4f10~0x4f11</LfsGr>
        <LfsR>0x4f12~0x4f13</LfsR>
        <LfsB>0x4f14~0x4f15</LfsB>
        <LfsGb>0x4f16~0x4f17</LfsGb>
        <SeGr>0x4f20~0x4f21</SeGr>
