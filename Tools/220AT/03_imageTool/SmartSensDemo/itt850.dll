        <!--开关0x5300[0]-->
        <DnsFlatInt>0x5330~0x5335</DnsFlatInt>
        <!--DnsFlatInt 1~6，每8bit为一个值-->
        <DnsFlatCoe>0x5336~0x533b</DnsFlatCoe>
        <!--DnsFlatCoe 1~6，每8bit为一个值-->
