        <SeB>0x4f24~0x4f25</SeB>
        <SeGb>0x4f26~0x4f27</SeGb>
        <CurBGain ReadOnly="1">0x4f04,0x4f05</CurBGain>
        <CurRGain ReadOnly="1">0x4f02,0x4f03</CurRGain>
        <CTThreL>0x4765,0x4766</CTThreL>
        <CTThreM>0x4767,0x4768</CTThreM>
        <CTThreH>0x4769,0x476a</CTThreH>
        <BGainL>0x955e,0x955f</BGainL>
        <RGainL>0x9560,0x9561</RGainL>
        <GGainL>0x9562,0x9563</GGainL>
        <BGainM>0x9564,0x9565</BGainM>
        <RGainM>0x9566,0x9567</RGainM>
        <GGainM>0x9568,0x9569</GGainM>
        <BGainH>0x956a,0x956b</BGainH>
        <RGainH>0x956c,0x956d</RGainH>
        <GGainH>0x956e,0x956f</GGainH>
        <OutputBGain ReadOnly="1">0x4f14,0x4f15</OutputBGain>
        <OutputRGain ReadOnly="1">0x4f12,0x4f13</OutputRGain>
        <OutputGGain ReadOnly="1">0x4f10,0x4f11</OutputGGain>
        <!-- CCM -->
        <CCM_Enable>0x5020</CCM_Enable>
        <!-- CCM enable：0x5020[0] -->
        <CCMA_RG>0x5440,0x5441</CCMA_RG>
        <CCMA_RB>0x5442,0x5443</CCMA_RB>
        <CCMA_GR>0x5444,0x5445</CCMA_GR>
        <CCMA_GB>0x5446,0x5447</CCMA_GB>
        <CCMA_BR>0x5448,0x5449</CCMA_BR>
        <CCMA_BG>0x544a,0x544b</CCMA_BG>
        <CCMB_RG>0x5450,0x5451</CCMB_RG>
        <CCMB_RB>0x5452,0x5453</CCMB_RB>
        <CCMB_GR>0x5454,0x5455</CCMB_GR>
        <CCMB_GB>0x5456,0x5457</CCMB_GB>
        <CCMB_BR>0x5458,0x5459</CCMB_BR>
        <CCMB_BG>0x545a,0x545b</CCMB_BG>
        <CCMC_RG>0x5460,0x5461</CCMC_RG>
        <CCMC_RB>0x5462,0x5463</CCMC_RB>
        <CCMC_GR>0x5464,0x5465</CCMC_GR>
        <CCMC_GB>0x5466,0x5467</CCMC_GB>
        <CCMC_BR>0x5468,0x5469</CCMC_BR>
        <CCMC_BG>0x546a,0x546b</CCMC_BG>
    </regAddrInfo_WB_CCM>
    <regAddrInfo_AE133>
        <Raw ReadOnly="1">0x6e30</Raw>
        <PostCurve ReadOnly="1">0x5607</PostCurve>
        <Exp_Type>0x3e03</Exp_Type>
        <!--Exp_Type: manual：0x3e03[0]=1，0x3e03 [1]=1-->
        <!--Exp_Type: auto：0x3e03 [0]=0, 0x3e03 [1]=0-->
        <Exp_Manual_IntTime>0x3e00,0x3e01,0x3e02</Exp_Manual_IntTime>
        <Exp_Auto_IntTime_Min>0x5e82,0x5e83</Exp_Auto_IntTime_Min>
        <Exp_Auto_IntTime_Max>0x5e88,0x5e89</Exp_Auto_IntTime_Max>
        <AGain_Manual_Gain>0x3e08,0x3e09</AGain_Manual_Gain>
        <AGain_Auto_Gain_Min>0x5e76,0x5e77</AGain_Auto_Gain_Min>
        <AGain_Auto_Gain_Max>0x5e7c,0x5e7d</AGain_Auto_Gain_Max> 
        <ExpGainCGain ReadOnly="1">0x3e00,0x3e01,0x3e02</ExpGainCGain>
        <ExpGainCEX>0x3e08,0x3e09</ExpGainCEX>
        <AETarget1>0x5e62</AETarget1>
        <AETarget2>0x5ee4</AETarget2>
        <AETarget3>0x5ee5</AETarget3>
        <AETarget4>0x5ee6</AETarget4>
        <AETargetThre1>0x5ee8,0x5ee9</AETargetThre1>
        <!--0x80 is 1x-->
        <AETargetThre2>0x5eea,0x5eeb</AETargetThre2>
        <!--0x80 is 1x-->
        <AETargetThre3>0x5eec,0x5eed</AETargetThre3>
        <!--0x80 is 1x-->
        <AETargetThre4>0x5eee,0x5eef</AETargetThre4>
        <!--0x80 is 1x-->
        <AESpeedFM>0x5e66</AESpeedFM>
        <!--expo ae speed-->
        <AESpeedSM>0x5e67</AESpeedSM>
        <!--expo ae speed-->      
        <AETolerance1>0x5e68</AETolerance1>
        <!--exp ae tolerance: unstable to stable-->
        <AETolerance2>0x5e69</AETolerance2>
        <!--exp ae tolerance: stable to unstable-->
        <ROIMirrorEnable>0x3221</ROIMirrorEnable>
        <ROILeft>0x6fb0,0x6fb1</ROILeft>
        <ROITop>0x6fb2,0x6fb3</ROITop>
        <ROIWidth>0x6fb4,0x6fb5</ROIWidth>
        <ROIHeight>0x6fb6,0x6fb7</ROIHeight>
        <ROIXShift>0x3210,0x3211</ROIXShift>
        <ROIYShift>0x3212,0x3213</ROIYShift>
        <Block>0x6f80~0x6f8f</Block>
        <!-- 0x6f80-0x6f8f（每2个bit为一个数值）-->
    </regAddrInfo_AE133>
    <regAddrInfo_GAMMA_133>
        <!--133AT_233AT Gamma-->
        <GammaA>0x5440~0x5481</GammaA>
        <GammaB>0x5482~0x54c3</GammaB>
        <Enable>0x502e</Enable>
        <!--使能开关[3]-->
        <Gain_Thresold>0x5420~0x5423</Gain_Thresold>
        <!--Gain Thresold1: 0x5420,0x5421;Gain Thresold2: 0x5422,0x5423-->
    </regAddrInfo_GAMMA_133>
    <regAddrInfo_Contrast133>
        <Enable>0x502e</Enable>
        <!--0x502e[4] -->
        <HightLevelType>0x5600</HightLevelType>
        <!--0x5600[1], 自动/手动模式切换-->
        <hight_level_cur_contrast ReadOnly="1">0x5605</hight_level_cur_contrast>
        <!--0x5605, read-->
        <hight_level_manual>0x5610</hight_level_manual>
        <!--0x5610, 手动模式下对比度调整-->
        <hight_level_auto>0x5610~0x5617</hight_level_auto>
        <!--0x5610~0x5617 自动模式下随增益自适应-->
        <low_level_type>0x5600</low_level_type>
        <!--0x5600[2], 自动/手动模式切换-->
        <low_level_cur_contrast ReadOnly="1">0x5606</low_level_cur_contrast>
        <!--0x5606, read-->
        <low_level_manual>0x5618</low_level_manual>
        <!--0x5618, 手动模式下对比度调整-->
        <low_level_auto>0x5618~0x561f</low_level_auto>
        <!--0x5618~0x561f 自动模式下随增益自适应-->
        <thre_l>0x5420,0x5421</thre_l>
        <thre_2>0x5422,0x5423</thre_2>
        <!--AutoLowLevel133-->
        <AutoLowLevelEnable>0x502e</AutoLowLevelEnable>
        <!--0x502e[3] -->
        <AutoLowLevelType>0x560c</AutoLowLevelType>
        <!--0x560c[7] -->
        <ManualLowLevel>0x560c</ManualLowLevel>
        <!-- 0x560c[6:0]，设置手动输入的low level 变化大小 -->
        <AutoLowLevel ReadOnly="1">0x5603</AutoLowLevel>
        <!-- 0x5603，为low level 自动变化时的实际大小 -->
        <CurGainLowLevel ReadOnly="1">0x5636</CurGainLowLevel>
        <LowLevelStartGain>0x560d</LowLevelStartGain>
        <!-- 0x560d设置low level 随增益变化的增益起始值，增益大于这个值，low level开始变化 -->
        <LowLevelSpeedGain>0x560c</LowLevelSpeedGain>
        <!-- 0x560c[1:0]，设置low level 随增益变化的快慢，2’b00,2’b01,2’b10,2’b11对应1/8,2/8,3/8,4/8 -->
        <LowLevelMaxGain>0x560f</LowLevelMaxGain>
        <!-- 0x560f[3:0]，*4，设置low level随增益变化最大值 -->
        <LowLevelSpeedTemperature>0x560c</LowLevelSpeedTemperature>
        <!-- 0x560c[3:2]，设置low level 随温度变化的快慢，2’b00,2’b01,2’b10,2’b11对应0,1,2,4 -->
        <LowLevelMaxTemperature>0x560f</LowLevelMaxTemperature>
        <!-- 0x560f[7:4]，*4，设置low level随温度变化最大值 -->
        <BrightInputChoose>0x560c</BrightInputChoose>
        <!-- 0x560c[6]，选择不同的亮度输入作为判断，0：选择AE曝光的平均值；1：选择curev之后的平均值 -->
        <LowLevelStartBright>0x560e</LowLevelStartBright>
        <!-- 0x560e[3:0]，*8设置low level 随亮度变化的亮度起始值（8bit，高位补零，显示运算后的value），亮度小于这个值，low level开始变化 -->
        <LowLevelSpeedBright>0x560c</LowLevelSpeedBright>
        <!-- 0x560c[5:4]，设置low level 随亮度变化的快慢，2’b00,2’b01,2’b10,2’b11对应1/8,2/8,3/8,4/8 -->
        <LowLevelMaxBright>0x560e</LowLevelMaxBright>
        <!-- 0x560e[7:4]，*4，设置low level随亮度变化最大值 --> 
        <!-- TemperatureEigenvalues-->
        <TemperatureType>0x5602</TemperatureType>
        <!-- 0x5602[7]=0/1 自动/手动模式切换-->  
        <TemperatureManualValue>0x5602</TemperatureManualValue>
        <!-- 0x5602[5:0] 手动调整温度值--> 
        <TemperatureAutoThre>0x5602</TemperatureAutoThre>
        <!-- 0x5602[6:0] 温度特征值计算阈值，当高温特征值大于阈值，温度特征值为正，否则为0-->
        <TemperatureAutoRadio>0x5600</TemperatureAutoRadio>
        <!-- 0x5600[5:4] 高温特征值计算的ratio，2’b00: 0.5x; 2’b01: 1x; 2’b10: 2x; 2’b11: 4x-->
        <TemperatureAutoCurValue ReadOnly="1">0x5604</TemperatureAutoCurValue>
        <!-- 0x5604 当前的温度特征值计算值 -->
        <!--HTemp133-->
        <HTempEnable>0x5ec5</HTempEnable>
        <!--Enable :0x5ec5[0]=1-->
        <HTempType>0x5630</HTempType>
        <!--0x5630[7], 自动/手动模式切换-->
        <ManualMaxGain>0x5633</ManualMaxGain>
        <!--Manual max gain :0x5633[7:0] *16-->
        <AutoMaxGain ReadOnly="1">0x5634,0x5635</AutoMaxGain>
        <!--Auto max gain :0x5634[3:0] 0x5635[7:0]-->
        <CurrentHTempValue ReadOnly="1">0x5604</CurrentHTempValue>
        <!--当前高温值 :0x5604[5:0]-->
        <InHTempThre>0x5630</InHTempThre>
        <!--In high temp threshold :0x5630[3:0]*2 + 0x5630[6:4]-->
        <OutHTempThre>0x5630</OutHTempThre>
        <!--In high temp threshold :0x5630[3:0]*2 - 0x5630[6:4]-->
        <ManualTestEnabele>0x5602</ManualTestEnabele>
        <!--0x5602[7] -->
        <ManualTest>0x5602</ManualTest>
        <!--0x5602[5:0] -->
        <MaxGainAdjustSpeed>0x5631</MaxGainAdjustSpeed>
        <!--Max gain adjust speed :0x5631[3:0]-->
        <MaxGainAdjustSpeedMin>0x5632</MaxGainAdjustSpeedMin>
        <!--Max gain adjust speed minimum:0x5632[3:0]-->
        <MaxGainAdjustSpeedMax>0x5632</MaxGainAdjustSpeedMax>
        <!--Max gain adjust speed Maximum:0x5632[7:4]*4-->
    </regAddrInfo_Contrast133>
    <regAddrInfo_NR_133>
        <!--NR公共寄存器-->
        <ManualGainEnable>0x5300</ManualGainEnable>
