    <regAddrInfo_Saturation_122>
        <Manual_Saturation>0x5107</Manual_Saturation>
        <Gain_Enable>0x5100</Gain_Enable>
        <!--增益开关0x5100[5]-->
        <Current_Gain ReadOnly="1">0x3e08~0x3e09</Current_Gain>
        <!--当前实时增益-->
        <Start_Gain>0x51de</Start_Gain>
        <!--起始增益0x51de[7:0]-->
        <End_Gain>0x51dc~0x51de</End_Gain>
        <!--终止增益0x51dc[3:0],0x51dd[7:0]  [11:0]-->
        <Delta>0x51df</Delta>
        <!--delta 0x51df[6:0]-->
        <Normal_Processed_Enable>0x500c</Normal_Processed_Enable>
        <!-- 整体饱和度调整开关 500c[0]为1 开 -->
        <Normal_Processed_Type>0x5280</Normal_Processed_Type>
        <!-- 整体饱和度调整模式 1为自动增益模式，0为手动模式 -->
        <Normal_Processed_Manual>0x5288</Normal_Processed_Manual>
        <!-- 整体饱和度调整 手动模式 -->
        <Normal_Processed_Auto>0x5288~0x528f</Normal_Processed_Auto>
        <!-- 整体饱和度调整 自动模式 -->
        <Normal_Processed_Current ReadOnly="1">0x5284</Normal_Processed_Current>
        <!-- 整体饱和度调整 自动模式 当前饱和度 ReadOnly -->
        <Normal_Gain_Current ReadOnly="1">0x60a0</Normal_Gain_Current>
        <!-- 整体饱和度调整  当前长曝光增益-->
        <Blue_Pixel_Enable>0x5ae7</Blue_Pixel_Enable>
        <!-- 蓝色像素点饱和度调整开关 0x5ad0[2],置1，开 -->
        <Blue_Pixel_Base_Min>0x5a93</Blue_Pixel_Base_Min>
        <!-- 蓝色基准饱和度的最小值 0x5a93[7:4]*8 -->
        <Blue_Pixel_Base_Current ReadOnly="1">0x5aa6</Blue_Pixel_Base_Current>
        <!-- 当前场景蓝色基准饱和度 ReadOnly -->
        <Blue_Pixel_Gain_Thre>0x5a93</Blue_Pixel_Gain_Thre>
        <!-- 蓝色像素点增益起点阈值 0x5a93[3:0]*8 -->
        <Blue_Pixel_Gain_Current ReadOnly="1">0x60a0</Blue_Pixel_Gain_Current>
        <!-- 蓝色像素点当前长曝光增益 -->
        <Blue_Pixel_Scene_Thre>0x5a95</Blue_Pixel_Scene_Thre>
        <!-- 蓝色像素点场景判断阈值 -->
        <Blue_Pixel_Lower_Speed>0x5a94</Blue_Pixel_Lower_Speed>
        <!-- 蓝色像素点降低饱和度的快慢 [7:4]随色温增 [3:0]随增益降低 -->
        <Blue_Pixel_Color_Temp_Eigen ReadOnly="1">0x5aa0</Blue_Pixel_Color_Temp_Eigen>
        <!-- 蓝色像素点色温特征值 ReadOnly -->
        <Blue_Pixel_Processed_Enable>0x500c</Blue_Pixel_Processed_Enable>
        <!-- 蓝色像素点饱和度 整体饱和度调整开关 500c[0]为1 开 -->
        <Blue_Pixel_Processed_Manual>0x52a3</Blue_Pixel_Processed_Manual>
        <!-- 蓝色像素点饱和度 [7],置1，手动模式，[6:0]为手动设置值，否则为自动模式 -->
        <Blue_Pixel_Processed_Blue_Component>0x52a0</Blue_Pixel_Processed_Blue_Component>
        <!-- 蓝色点判断的蓝色分量附加判断 -->
        <Blue_Pixel_Processed_Red_Component>0x52a1</Blue_Pixel_Processed_Red_Component>
        <!-- 蓝色点判断的红色分量附加判断 -->
        <Blue_Pixel_Processed_Speed>0x52a2</Blue_Pixel_Processed_Speed>
        <!-- 0x52a2[3:0]蓝色点判断，蓝色分量符合要求的快慢，0x52a2[7:4]蓝色点判断，红色分量符合要求的快慢 -->
        <Red_Scene_Processed_Enable>0x500c</Red_Scene_Processed_Enable>
        <!-- 红色场景 整体饱和度调整开关 500c[0]为1 开 -->
        <Red_Scene_Processed_Lower>0x5280</Red_Scene_Processed_Lower>
        <!-- 红色场景降饱和度 0x5280[4]为1为打开红色场景降饱和度，0为关闭 -->
        <Red_Scene_Enable>0x5ae7</Red_Scene_Enable>
        <!-- 0x5ae7[0],置1，开启红色场景饱和度调整的计算 -->
        <Red_Scene_Base_Min>0x5a90</Red_Scene_Base_Min>
        <!-- 红色基准饱和度的最小值 0x5a90[7:4]*8 -->
        <Red_Scene_Base_Current ReadOnly="1">0x5aa5</Red_Scene_Base_Current>
        <!-- 当前场景红色场景饱和度 ReadOnly -->
        <Red_Scene_Gain_Thre>0x5a90</Red_Scene_Gain_Thre>
        <!-- 红色场景增益起点阈值 0x5a90[3:0]*8 -->
        <Red_Scene_Gain_Current ReadOnly="1">0x60a0</Red_Scene_Gain_Current>
        <!-- 红色场景当前长曝光增益 -->
        <Red_Scene_Scene_Thre>0x5a92</Red_Scene_Scene_Thre>
        <!-- 红色场景场景判断阈值 -->
        <Red_Scene_Eigen ReadOnly="1">0x5aa1</Red_Scene_Eigen>
        <!-- 红色场景特征值ReadOnly -->
        <Red_Scene_Lower_Speed>0x5a91</Red_Scene_Lower_Speed>
        <!-- 红色场景降低饱和度的快慢 0x5a91[3:0]随增益增加时下降快慢 [7:4]随红色场景变红的下降快慢 -->
        <Bright_Adaptive_Enable>0x52ad</Bright_Adaptive_Enable>
        <!-- 0x52ad[7]写1，打开局部亮度自适应调整饱和度功能 -->
        <Bright_Adaptive_Bright_Thre>0x52af</Bright_Adaptive_Bright_Thre>
