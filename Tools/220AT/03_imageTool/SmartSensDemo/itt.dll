        <NR_Short_Manual_Strength>0x62ec</NR_Short_Manual_Strength>
        <!--0x62ec[6:0]为去噪强度设置，值越大去噪强度越小，值为0x40时，去噪强度为0-->
        <NR_Short_Auto_Thre_Base>0x62eb</NR_Short_Auto_Thre_Base>
        <!--0x62eb[4:0]设置细节判断阈值基准值，边缘特征值大于此阈值去噪开始减弱-->
        <NR_Short_Auto_Thre_Ratio>0x62eb</NR_Short_Auto_Thre_Ratio>
        <!--0x62eb[7:5]设置阈值ratio，值越大，阈值越小，去噪强度会越小-->
        <NR_Short_Auto_Strength_Max>0x62ec</NR_Short_Auto_Strength_Max>
        <!--0x62ec[6:0]为去噪最大强度设置。0，最强，0x40，最小-->
    </regAddrInfo_NR>
