        <HDREnableNew>0x7532</HDREnableNew>
        <!-- 0x7532[3] -->
        <LoadEnable>0x4739,0x7532</LoadEnable>
        <!-- 0x4739[1],0x7532[1] -->
        <HDREnable>0x57db</HDREnable>
        <!-- 0x57db[0] : max gamma
             0x57db[1] : global gamma
             0x57db[2] : local gamma alpha
             0x57db[3] : curve alpha
             0x57db[4] : high margin
             0x57db[5] : awb luma low th
             0x57db[6] : ae target
             0x57db[7] : comps -->
        <IntGainLuma ReadOnly="1">0xc012</IntGainLuma>
        <!-- intL_m = 4/16，r_int_gain_luma[1][0] == 11
             intL_m = 3/16，r_int_gain_luma[1][0] == 10
             intL_m = 2/16，r_int_gain_luma[1][0] == 01
             intL_m = 1/16，r_int_gain_luma[1][0] == 00
             gainL_m = 8，  r_int_gain_luma[3][2] == 11
             gainL_m = 7，  r_int_gain_luma[3][2] == 10
             gainL_m = 5，  r_int_gain_luma[3][2] == 01
             gainL_m = 4，  r_int_gain_luma[3][2] == 00
             lumaL_m = 4，  r_int_gain_luma[5][4] == 11
             lumaL_m = 3，  r_int_gain_luma[5][4] == 10
             lumaL_m = 2，  r_int_gain_luma[5][4] == 01
             lumaL_m = 1，  r_int_gain_luma[5][4] == 00 -->
        <LumaTh ReadOnly="1">0xc011</LumaTh>
        <Base ReadOnly="1">0xc013</Base>
        <IntGainLumaUpdate ReadOnly="1">0x5d40,0x5d41</IntGainLumaUpdate>
        <DyTh1 ReadOnly="1">0xc014</DyTh1>
