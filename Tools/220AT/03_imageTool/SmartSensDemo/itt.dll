        <TemperatureManualValue>0x52ad,0x52ae</TemperatureManualValue>
        <!-- 0x52ad[5:4], 0x52ae[7:0]手动调整附加增益--> 
        <TemperatureAutoThre>0x52ae</TemperatureAutoThre>
        <!-- 0x52ae[5:0] 温度特征值计算阈值，当高温特征值大于阈值，温度特征值为正，否则为0-->
        <TemperatureAutoRadio>0x52ae</TemperatureAutoRadio>
        <!-- 0x52ae[7:6] 高温特征值计算的ratio，2’b00: 0.5x; 2’b01: 1x; 2’b10: 2x; 2’b11: 4x-->
        <TemperatureAutoCurValue ReadOnly="1">0x52b6,0x52b7</TemperatureAutoCurValue>
        <!-- 0x52b6[2:0],0x52b7[7:0] 当前的温度特征值计算值 -->
		<TemperatureEnable>0x5032</TemperatureEnable>
		<TemperatureLensEnable>0x5032</TemperatureLensEnable>
