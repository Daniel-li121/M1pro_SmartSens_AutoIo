    <regAddrInfo_AutoLowLevel>
        <CurvePreEnable>0x5011</CurvePreEnable>
        <!-- 0x5011[5] 置1 打开curve pre模块 -->
        <LowLevelType>0x5a96</LowLevelType>
        <!-- 0x5a96[7] 置1，进入手动模式
             0x5a96[7] 置0，进入自动模式 -->
        <ManualLowLevel>0x5a96</ManualLowLevel>
        <!-- 0x5a96[6:0]，设置手动输入的low level 变化大小 -->
        <AutolLowLevel>0x5aa4</AutolLowLevel>
        <!-- 0x5aa4，为low level 自动变化时的实际大小 -->
        <LowLevelStartGain>0x5add</LowLevelStartGain>
        <!-- 0x5add设置low level 随增益变化的增益起始值，增益大于这个值，low level开始变化 -->
        <LowLevelSpeedGain>0x5adc</LowLevelSpeedGain>
        <!-- 0x5adc[1:0]，设置low level 随增益变化的快慢，2’b00,2’b01,2’b10,2’b11对应1/8,2/8,3/8,4/8 -->
        <LowLevelMaxGain>0x5ade</LowLevelMaxGain>
        <!-- 0x5ade[3:0]，*4，设置low level随增益变化最大值 -->
        <LowLevelSpeedTemp>0x5adc</LowLevelSpeedTemp>
        <!-- 0x5adc[3:2]，设置low level 随温度升高变化的快慢，2’b00,2’b01,2’b10,2’b11对应0,1,2,4 -->
        <LowLevelMaxTemp>0x5ade</LowLevelMaxTemp>
        <!-- 0x5ade[7:4]，*4，设置low level随温度变化最大值 -->
        <BrightInputChoose>0x5a96</BrightInputChoose>
        <!-- 0x5a96[6]，选择不同的亮度输入作为判断，0：选择AE长曝光的平均值；1：选择curev之后的平均值 -->
        <LowLevelStartBright>0x5a97</LowLevelStartBright>
        <!-- 0x5a97[3:0]，*8设置low level 随亮度变化的亮度起始值（8bit，高位补零，显示运算后的value），亮度小于这个值，low level开始变化 -->
        <LowLevelSpeedBright>0x5a96</LowLevelSpeedBright>
        <!-- 0x5a96[5:4]，设置low level 随亮度变化的快慢，2’b00,2’b01,2’b10,2’b11对应1/8,2/8,3/8,4/8 -->
        <LowLevelMaxBright>0x5a97</LowLevelMaxBright>
        <!-- 0x5a97[7:4]，*2，设置low level随增益变化最大值 -->
        <CurrentGain ReadOnly="1">0x60ef</CurrentGain>
        <!--Current gain :0x60ef-->
        <CurrentTemp ReadOnly="1">0x5ae7</CurrentTemp>
        <!--Current temperature :0x5ae7[5:0]-->
        <!-- TemperatureEigenvalues-->
        <TemperatureType>0x52ad</TemperatureType>
        <!-- 0x5602[6]=0/1 自动/手动模式切换-->
        <TemperatureManualValue>0x52ad,0x52ae</TemperatureManualValue>
        <!-- 0x52ad[5:4], 0x52ae[7:0]手动调整附加增益-->
        <TemperatureAutoThre>0x52ae</TemperatureAutoThre>
        <!-- 0x52ae[5:0] 温度特征值计算阈值，当高温特征值大于阈值，温度特征值为正，否则为0-->
        <TemperatureAutoRadio>0x52ae</TemperatureAutoRadio>
        <!-- 0x52ae[7:6] 高温特征值计算的ratio，2’b00: 0.5x; 2’b01: 1x; 2’b10: 2x; 2’b11: 4x-->
        <TemperatureAutoCurValue ReadOnly="1">0x52b6,0x52b7</TemperatureAutoCurValue>
        <!-- 0x52b6[2:0],0x52b7[7:0] 当前的温度特征值计算值 -->
        <TemperatureEnable>0x5032</TemperatureEnable>
        <TemperatureLensEnable>0x5032</TemperatureLensEnable>
        <!-- 0x5032[5] lens, 0x5032[2] CIP,AEB,SAT_CON-->
		<AutoLowLevelEnable>0x5101</AutoLowLevelEnable>
        <!-- 0x5101[4]-->
    </regAddrInfo_AutoLowLevel>
